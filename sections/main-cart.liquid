<!-- MAIN CART SECTION -->
<section class="cart-page-section">
  <div class="container">
    <div class="cart-page-head reveal">
      <span class="chip chip-yellow">SHOPPING BAG</span>
      <h1>Your <em>Cart</em></h1>
      <p class="cart-head-subtitle">Review your performance hydration lineup before checkout.</p>
    </div>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" class="cart-page-form" id="cartPageForm">
        <div class="cart-page-grid">
          <!-- Cart Items List -->
          <div class="cart-items-container">
            <div class="cart-items-header">
              <span>Product</span>
              <span>Price</span>
              <span>Quantity</span>
              <span>Total</span>
            </div>

            <div class="cart-items-list">
              {% for item in cart.items %}
                <div class="cart-item-row" data-key="{{ item.key }}">
                  <div class="cart-item-info">
                    <a href="{{ item.url }}" class="cart-item-media">
                      {% if item.image %}
                        <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.title | escape }}" />
                      {% else %}
                        <img src="{{ 'can-lime.png' | asset_url }}" alt="{{ item.title | escape }}" />
                      {% endif %}
                    </a>
                    <div class="cart-item-details">
                      <a href="{{ item.url }}" class="cart-item-name">{{ item.product.title }}</a>
                      {% unless item.product.has_only_default_variant %}
                        <span class="cart-item-spec">{{ item.variant.title }}</span>
                      {% endunless %}
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="cart-item-remove-link">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        Remove
                      </a>
                    </div>
                  </div>

                  <div class="cart-item-unit-price">
                    {{ item.final_price | money }}
                  </div>

                  <div class="cart-item-quantity">
                    <div class="qty-stepper">
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="qty-btn" aria-label="Decrease quantity">−</a>
                      <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" aria-label="Quantity" class="qty-input">
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="qty-btn" aria-label="Increase quantity">+</a>
                    </div>
                  </div>

                  <div class="cart-item-line-price">
                    {{ item.final_line_price | money }}
                  </div>
                </div>
              {% endfor %}
            </div>

            <div class="cart-actions-bar">
              <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="btn btn-ghost">
                ← Continue Shopping
              </a>
              <button type="submit" name="update" class="btn btn-secondary">
                Update Cart
              </button>
            </div>
          </div>

          <!-- Order Summary Card -->
          <div class="cart-summary-card">
            <h2>Order <em>Summary</em></h2>
            
            <div class="summary-line">
              <span>Subtotal</span>
              <span class="summary-amount">{{ cart.total_price | money }}</span>
            </div>

            <div class="summary-shipping-note">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span>Taxes and shipping calculated at checkout</span>
            </div>

            <div class="summary-checkout-actions">
              <button type="submit" name="checkout" class="btn btn-primary btn-block cart-checkout-btn">
                Proceed to Checkout →
              </button>
            </div>

            <div class="cart-trust-badges">
              <div class="trust-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span>Encrypted 256-Bit Checkout</span>
              </div>
              <div class="trust-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                <span>Instant Shipping Processing</span>
              </div>
            </div>
          </div>
        </div>
      </form>
    {% else %}
      <!-- Empty Cart State -->
      <div class="cart-empty-wrapper reveal">
        <div class="cart-empty-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#91B9EA" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        </div>
        <h2>Your Cart is <em>Empty</em></h2>
        <p>Looks like you haven't added any SPLYN performance hydration cans to your cart yet.</p>
        <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="btn btn-primary">
          Explore Flavors →
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
