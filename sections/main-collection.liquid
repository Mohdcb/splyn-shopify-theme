<!-- MAIN COLLECTION PAGE -->
<section class="collection-page">
  <div class="container">

    <!-- Collection Header -->
    <div class="collection-header section-head reveal">
      <span class="chip chip-yellow">{{ section.settings.chip_text | default: 'Collection' }}</span>
      <h1 class="collection-title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <p>{{ collection.description }}</p>
      {% endif %}
    </div>

    <!-- Sort & Filter Bar -->
    <div class="collection-toolbar reveal">
      <span class="collection-count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</span>
      <div class="collection-sort">
        <label for="SortBy">Sort by:</label>
        <select id="SortBy" onchange="window.location.href = this.value;">
          {% for option in collection.sort_options %}
            <option value="{{ collection.url }}?sort_by={{ option.value }}"
              {% if collection.sort_by == option.value %}selected{% endif %}>
              {{ option.name }}
            </option>
          {% endfor %}
        </select>
      </div>
    </div>

    <!-- Product Grid -->
    {% if collection.products.size > 0 %}
      <div class="collection-grid reveal">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>

      <!-- Pagination -->
      {% if paginate.pages > 1 %}
        <div class="collection-pagination">
          {{ paginate | default_pagination: next: '→', previous: '←' }}
        </div>
      {% endif %}
    {% else %}
      <div class="collection-empty reveal">
        <i data-lucide="package"></i>
        <h3>No products found</h3>
        <p>Check back soon — we're always adding new flavors and products.</p>
        <a href="{{ routes.root_url }}" class="btn btn-primary">Back to Home</a>
      </div>
    {% endif %}

  </div>
</section>

<style>
  .collection-page {
    padding: 60px 0 120px;
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
  }

  .collection-header {
    margin-bottom: 40px;
  }

  .collection-title {
    font-family: 'Poppins', sans-serif;
    font-weight: 800;
    font-size: clamp(34px, 4.5vw, 56px);
    line-height: 1.05;
    letter-spacing: -1px;
    color: var(--purple-900);
    margin-top: 14px;
  }

  .collection-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 40px;
    padding: 16px 24px;
    background: #fff;
    border-radius: 20px;
    border: 1.5px solid var(--purple-100);
  }

  .collection-count {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }

  .collection-sort {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--purple-900);
  }

  .collection-sort label {
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .collection-sort select {
    padding: 8px 16px;
    border-radius: 20px;
    border: 1.5px solid var(--purple-100);
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    color: var(--purple-900);
    background: var(--purple-50);
    cursor: pointer;
    outline: none;
  }

  .collection-sort select:focus {
    border-color: var(--purple-300);
  }

  /* Product Grid */
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  /* Product Card Styles */
  .product-card {
    background: #fff;
    border-radius: 24px;
    border: 1.5px solid var(--purple-100);
    overflow: hidden;
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
  }

  .product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 30px 60px -30px rgba(15, 52, 94, 0.2);
    border-color: var(--purple-300);
  }

  .product-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .product-card-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: linear-gradient(135deg, var(--purple-50) 0%, #fff 100%);
  }

  .product-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  .product-card:hover .product-card-image img {
    transform: scale(1.08);
  }

  .product-card-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    font-size: 11px;
    padding: 4px 12px;
  }

  .product-card-info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .product-card-vendor {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--muted);
  }

  .product-card-title {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: var(--purple-900);
    line-height: 1.3;
    margin: 0;
  }

  .product-card-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 4px;
  }

  .product-card-current {
    font-family: 'Poppins', sans-serif;
    font-size: 20px;
    font-weight: 800;
    color: var(--purple-900);
  }

  .product-card-compare {
    font-size: 14px;
    color: var(--muted);
    text-decoration: line-through;
  }

  .product-card-form {
    padding: 0 20px 20px;
  }

  .product-card-btn {
    width: 100%;
    text-align: center;
    cursor: pointer;
    border: none;
    font-family: 'Poppins', sans-serif;
    padding: 12px 20px;
    font-size: 14px;
  }

  .product-card-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Pagination */
  .collection-pagination {
    margin-top: 60px;
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  .collection-pagination a,
  .collection-pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
    padding: 8px 16px;
    border-radius: 20px;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .collection-pagination a {
    background: #fff;
    color: var(--purple-900);
    border: 1.5px solid var(--purple-100);
  }

  .collection-pagination a:hover {
    background: var(--yellow);
    border-color: var(--purple-900);
    transform: translateY(-2px);
  }

  .collection-pagination span.current {
    background: var(--purple-900);
    color: var(--yellow);
    border: 1.5px solid var(--purple-900);
  }

  /* Empty State */
  .collection-empty {
    text-align: center;
    padding: 80px 20px;
    background: #fff;
    border-radius: 28px;
    border: 1.5px solid var(--purple-100);
  }

  .collection-empty svg {
    width: 48px;
    height: 48px;
    stroke: var(--muted);
    margin-bottom: 20px;
  }

  .collection-empty h3 {
    font-family: 'Poppins', sans-serif;
    font-size: 24px;
    color: var(--purple-900);
    margin-bottom: 12px;
  }

  .collection-empty p {
    color: var(--muted);
    font-size: 16px;
    margin-bottom: 24px;
  }

  /* Responsive */
  @media(max-width: 1024px) {
    .collection-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media(max-width: 768px) {
    .collection-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .collection-toolbar {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
    }
  }

  @media(max-width: 480px) {
    .collection-grid {
      grid-template-columns: 1fr;
    }

    .product-card-info {
      padding: 16px;
    }

    .product-card-form {
      padding: 0 16px 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Collection Page",
  "settings": [
    {
      "type": "text",
      "id": "chip_text",
      "label": "Chip Text",
      "default": "Collection"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products Per Page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 16
    }
  ]
}
{% endschema %}
