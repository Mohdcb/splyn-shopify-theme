<footer class="foot">

  <!-- Newsletter Bar -->
  <div class="foot-newsletter" id="foot-newsletter">
    <div class="container foot-newsletter-inner">
      <div class="foot-nl-copy">
        <h3>{{ section.settings.newsletter_heading | default: 'Stay in the loop.' }}</h3>
        <p>{{ section.settings.newsletter_subtext | default: 'Early drops, exclusive deals, and community updates — straight to your inbox.' }}</p>
      </div>
      {% form 'customer', class: 'foot-nl-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email address' }}" required />
        <button type="submit">{{ section.settings.newsletter_button_text | default: 'Subscribe' }} <i class="ph-duotone ph-paper-plane-right" style="font-size: 18px; margin-left: 6px;"></i></button>
      {% endform %}
    </div>
  </div>

  <!-- Main Footer Grid -->
  <div class="foot-main">
    <div class="container foot-grid">

      <!-- Brand Column -->
      <div class="foot-col foot-brand-col">
        {% if section.settings.footer_logo != blank %}
          <img src="{{ section.settings.footer_logo | image_url: width: 300 }}" alt="{{ shop.name }}" class="foot-logo" />
        {% else %}
          <img src="{{ 'splyn-logo-white.svg' | asset_url }}" alt="{{ shop.name }}" class="foot-logo" />
        {% endif %}
        <p class="foot-tagline">{{ section.settings.tagline | default: 'Performance hydration built for the way you actually live. Clean energy. Deep hydration. Zero sugar.' }}</p>
        
        <!-- Social Media Icons (With Default Fallback URLs) -->
        <div class="foot-socials">
          <a href="{{ section.settings.social_instagram | default: 'https://instagram.com/splyn.in' }}" target="_blank" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="{{ section.settings.social_twitter | default: 'https://x.com/splyn_in' }}" target="_blank" aria-label="Twitter / X">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622 5.912-5.622Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="{{ section.settings.social_tiktok | default: 'https://tiktok.com/@splyn.in' }}" target="_blank" aria-label="TikTok">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.73a8.22 8.22 0 0 0 4.78 1.52V6.79a4.85 4.85 0 0 1-1.01-.1z"/></svg>
          </a>
          <a href="{{ section.settings.social_whatsapp | default: 'https://chat.whatsapp.com' }}" target="_blank" aria-label="WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          </a>
        </div>
      </div>

      <!-- Link Columns (with Default Menus if empty) -->
      {% assign link_blocks = section.blocks | where: 'type', 'link_column' %}
      {% if link_blocks.size > 0 %}
        {% for block in link_blocks %}
          <div class="foot-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            {% if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 %}
              <ul>
                {% for link in linklists[block.settings.menu].links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            {% else %}
              <!-- Fallback Default Menu per heading -->
              {% assign h_lower = block.settings.heading | downcase %}
              {% if h_lower contains 'shop' or h_lower contains 'product' %}
                <ul>
                  {% if collections.all.products.size > 0 %}
                    {% for prod in collections.all.products limit: 6 %}
                      <li><a href="{{ prod.url }}">{{ prod.title }}</a></li>
                    {% endfor %}
                  {% else %}
                    <li><a href="/collections/all">Lemon Lime</a></li>
                    <li><a href="/collections/all">Raspberry Peach</a></li>
                    <li><a href="/products/flavour-mix">Flavour Mix</a></li>
                  {% endif %}
                </ul>
              {% elsif h_lower contains 'company' or h_lower contains 'about' %}
                <ul>
                  <li><a href="#story">Our Story</a></li>
                  <li><a href="#ingredients">Ingredients</a></li>
                  <li><a href="#comparison">SPLYN Advantage</a></li>
                  <li><a href="#community">Community</a></li>
                </ul>
              {% else %}
                <ul>
                  <li><a href="#hero">Home</a></li>
                  <li><a href="#flavors">Shop All</a></li>
                  <li><a href="#ingredients">Why SPLYN</a></li>
                  <li><a href="#community">Join Movement</a></li>
                </ul>
              {% endif %}
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Fallback Navigation Columns -->
        <div class="foot-col">
          <h4>Shop</h4>
          <ul>
            {% if collections.all.products.size > 0 %}
              {% for prod in collections.all.products limit: 6 %}
                <li><a href="{{ prod.url }}">{{ prod.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/collections/all">Lemon Lime</a></li>
              <li><a href="/collections/all">Raspberry Peach</a></li>
              <li><a href="/products/flavour-mix">Flavour Mix</a></li>
            {% endif %}
          </ul>
        </div>
        <div class="foot-col">
          <h4>Company</h4>
          <ul>
            <li><a href="#story">Our Story</a></li>
            <li><a href="#ingredients">Human Body Ingredients</a></li>
            <li><a href="#comparison">The SPLYN Advantage</a></li>
            <li><a href="#community">Join the Family</a></li>
          </ul>
        </div>
      {% endif %}

      <!-- Contact Column (with Default Fallback Content) -->
      {% assign contact_blocks = section.blocks | where: 'type', 'contact_column' %}
      {% if contact_blocks.size > 0 %}
        {% for block in contact_blocks %}
          <div class="foot-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading | default: 'Contact Us' }}</h4>
            <ul class="foot-contact">
              <li>
                <i class="ph-duotone ph-envelope-simple"></i>
                <a href="mailto:{{ block.settings.email | default: 'support@drinksplyn.com' }}">{{ block.settings.email | default: 'support@drinksplyn.com' }}</a>
              </li>
              <li>
                <i class="ph-duotone ph-phone"></i>
                <a href="tel:{{ block.settings.phone | default: '+919663829900' | remove: ' ' }}">{{ block.settings.phone | default: '+91 9663829900' }}</a>
              </li>
              <li>
                <i class="ph-duotone ph-map-pin"></i>
                <span>{{ block.settings.address | default: 'Bangalore, Karnataka<br/>India — 560001' }}</span>
              </li>
            </ul>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Fallback Contact Column -->
        <div class="foot-col">
          <h4>Contact Us</h4>
          <ul class="foot-contact">
            <li>
              <i class="ph-duotone ph-envelope-simple"></i>
              <a href="mailto:support@drinksplyn.com">support@drinksplyn.com</a>
            </li>
            <li>
              <i class="ph-duotone ph-phone"></i>
              <a href="tel:+919663829900">+91 9663829900</a>
            </li>
            <li>
              <i class="ph-duotone ph-map-pin"></i>
              <span>Bangalore, Karnataka<br/>India — 560001</span>
            </li>
          </ul>
        </div>
      {% endif %}

    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="foot-bottom">
    <div class="container foot-bottom-inner">
      <p>{{ section.settings.copyright | default: '© 2026 SPLYN Beverages Pvt. Ltd. All rights reserved.' }}</p>
      <div class="foot-legal">
        {% if section.settings.legal_menu != blank and linklists[section.settings.legal_menu].links.size > 0 %}
          {% for link in linklists[section.settings.legal_menu].links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy Policy</a>
          <a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms & Conditions</a>
          <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">Shipping Policy</a>
          <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">Refund Policy</a>
          <a href="/pages/razorpay-policy">Razorpay Policy</a>
        {% endif %}
      </div>
    </div>
  </div>

</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Stay in the loop."
    },
    {
      "type": "text",
      "id": "newsletter_subtext",
      "label": "Newsletter Subtext",
      "default": "Early drops, exclusive deals, and community updates — straight to your inbox."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "newsletter_button_text",
      "label": "Subscribe Button Text",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Brand Tagline",
      "default": "Performance hydration built for the way you actually live. Clean energy. Deep hydration. Zero sugar."
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "Twitter / X URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "social_whatsapp",
      "label": "WhatsApp URL"
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright Text",
      "default": "© 2026 SPLYN Beverages Pvt. Ltd. All rights reserved."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal Links Menu",
      "info": "Create a menu in Shopify for legal links. If empty, fallback links below are used."
    },
    {
      "type": "url",
      "id": "privacy_link",
      "label": "Privacy Policy URL (fallback)"
    },
    {
      "type": "url",
      "id": "terms_link",
      "label": "Terms of Service URL (fallback)"
    },
    {
      "type": "url",
      "id": "cookie_link",
      "label": "Cookie Policy URL (fallback)"
    },
    {
      "type": "url",
      "id": "refund_link",
      "label": "Refund Policy URL (fallback)"
    },
    {
      "type": "url",
      "id": "disclaimer_link",
      "label": "Disclaimer URL (fallback)"
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "contact_column",
      "name": "Contact Column",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading",
          "default": "Contact Us"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "hello@splyn.in"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "+91 98765 43210"
        },
        {
          "type": "html",
          "id": "address",
          "label": "Address",
          "default": "Bangalore, Karnataka<br/>India — 560001"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Business Hours",
          "default": "Mon – Fri, 9am – 6pm IST"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "link_column",
          "settings": { "heading": "Shop" }
        },
        {
          "type": "link_column",
          "settings": { "heading": "Company" }
        },
        {
          "type": "contact_column",
          "settings": { "heading": "Contact Us" }
        }
      ]
    }
  ]
}
{% endschema %}
