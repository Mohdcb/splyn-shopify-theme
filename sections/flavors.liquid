<!-- FLAVORS SWITCHING -->
<section id="flavors" class="flavors">
  <div class="container">
    <span class="chip chip-yellow reveal">{{ section.settings.chip_text }}</span>
    <h2 class="reveal">{{ section.settings.heading }} <em>{{ section.settings.heading_italic }}</em></h2>
    <p class="reveal">{{ section.settings.subtext }}</p>

    <div class="flavor-switch reveal">
      {% for block in section.blocks %}
        <button class="flavor-btn{% if forloop.first %} is-active{% endif %}" data-flavor="{{ block.settings.flavor_id }}" {{ block.shopify_attributes }}>
          <span class="swatch swatch-{{ block.settings.flavor_id }}"></span> {{ block.settings.flavor_label }}
        </button>
      {% endfor %}
    </div>

    <div class="flavor-stage reveal" data-theme="{{ section.blocks[0].settings.flavor_id }}">
      {% for block in section.blocks %}
        <div class="flavor-card flavor-card-{{ block.settings.flavor_id }}{% if forloop.first %} is-active{% endif %}" data-bg="{{ block.settings.flavor_id }}">
          <div class="flavor-copy">
            <h3>{{ block.settings.flavor_name }} <em>{{ block.settings.flavor_name_italic }}</em></h3>
            <p>{{ block.settings.description }}</p>
            <ul class="flavor-tags">
              {% assign tags = block.settings.tags | split: ',' %}
              {% for tag in tags %}
                <li>{{ tag | strip }}</li>
              {% endfor %}
            </ul>
            <div class="flavor-meta">
              <div><b>{{ block.settings.caffeine }}</b><span>Caffeine</span></div>
              <div><b>{{ block.settings.sugar }}</b><span>Sugar</span></div>
              <div><b>{{ block.settings.size }}</b><span>Per can</span></div>
            </div>
            <a href="{{ block.settings.cta_link }}" class="btn btn-primary btn-large">{{ block.settings.cta_text }}</a>
          </div>
          <div class="flavor-media">
            <div class="orb orb-{{ block.settings.flavor_id }}"></div>
            {% if block.settings.can_image != blank %}
              <img class="rotate-can" src="{{ block.settings.can_image | image_url: width: 800 }}" alt="{{ block.settings.flavor_name }} can" style="max-height: 580px;" />
            {% else %}
              {% if block.settings.flavor_id == 'lime' %}
                <img class="rotate-can" src="{{ 'can-lime.png' | asset_url }}" alt="Lime can" style="max-height: 580px;" />
              {% else %}
                <img class="rotate-can" src="{{ 'can-raspberry.png' | asset_url }}" alt="Raspberry can" style="max-height: 580px;" />
              {% endif %}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Flavor Switcher",
  "settings": [
    {
      "type": "text",
      "id": "chip_text",
      "label": "Chip Text",
      "default": "Two Flavors. One Mission."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick your"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (Italic)",
      "default": "vibe."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Tap a flavor to switch the world. The site shifts, the can rotates, the energy changes."
    }
  ],
  "blocks": [
    {
      "type": "flavor",
      "name": "Flavor Card",
      "settings": [
        {
          "type": "text",
          "id": "flavor_id",
          "label": "Flavor ID (e.g. lime, berry)",
          "default": "lime"
        },
        {
          "type": "text",
          "id": "flavor_label",
          "label": "Button Label",
          "default": "Lime"
        },
        {
          "type": "text",
          "id": "flavor_name",
          "label": "Flavor Name",
          "default": "Lime"
        },
        {
          "type": "text",
          "id": "flavor_name_italic",
          "label": "Flavor Name (Italic)",
          "default": "Crush"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Zesty citrus. Cool finish. Built for sun‑soaked workouts and afternoon resets."
        },
        {
          "type": "text",
          "id": "tags",
          "label": "Tags (comma separated)",
          "default": "Citrus Hit, Mint Cool, Crisp Finish"
        },
        {
          "type": "text",
          "id": "caffeine",
          "label": "Caffeine Amount",
          "default": "200mg"
        },
        {
          "type": "text",
          "id": "sugar",
          "label": "Sugar Amount",
          "default": "0g"
        },
        {
          "type": "text",
          "id": "size",
          "label": "Can Size",
          "default": "11.4 fl oz"
        },
        {
          "type": "image_picker",
          "id": "can_image",
          "label": "Can Image"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA Button Text",
          "default": "Add Lime to Cart"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA Button Link",
          "default": "/collections/all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flavor Switcher",
      "blocks": [
        {
          "type": "flavor",
          "settings": {
            "flavor_id": "lime",
            "flavor_label": "Lime",
            "flavor_name": "Lime",
            "flavor_name_italic": "Crush",
            "description": "Zesty citrus. Cool finish. Built for sun‑soaked workouts and afternoon resets.",
            "tags": "Citrus Hit, Mint Cool, Crisp Finish",
            "caffeine": "200mg",
            "sugar": "0g",
            "size": "11.4 fl oz",
            "cta_text": "Add Lime to Cart"
          }
        },
        {
          "type": "flavor",
          "settings": {
            "flavor_id": "berry",
            "flavor_label": "Raspberry",
            "flavor_name": "Raspberry",
            "flavor_name_italic": "Rush",
            "description": "Wild berries. Velvet finish. Designed for late nights, deep work, and golden hour.",
            "tags": "Wild Berry, Soft Sweet, Smooth Lift",
            "caffeine": "200mg",
            "sugar": "0g",
            "size": "11.4 fl oz",
            "cta_text": "Add Raspberry to Cart"
          }
        }
      ]
    }
  ]
}
{% endschema %}
