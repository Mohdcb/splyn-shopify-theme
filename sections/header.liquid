<!-- ANNOUNCEMENT BAR -->
<div class="announcement-bar">
  <div class="announcement-bar-inner">
    <i class="ph-duotone ph-truck"></i>
    <span>FREE SHIPPING ON ORDERS ABOVE ₹500</span>
  </div>
</div>

<!-- NAV -->
<header class="nav">
  <div class="nav-inner">
    <!-- Mobile Menu Toggle -->
    <button class="mobile-menu-toggle" aria-label="Menu" onclick="document.querySelector('.mobile-menu-overlay').classList.add('is-open'); document.body.style.overflow='hidden';">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <a class="brand" href="{{ routes.root_url }}">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" style="height: {{ section.settings.logo_height | default: 36 }}px;" />
      {% else %}
        <img src="{{ 'splyn-logo-white.svg' | asset_url }}" alt="{{ shop.name }}" style="height: {{ section.settings.logo_height | default: 36 }}px;" />
      {% endif %}
    </a>

    <!-- Desktop Nav -->
    <nav class="links">
      {% if section.settings.menu != blank %}
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="/">Home</a>
        <a href="/collections/all">Shop</a>
        <a href="/#story">About</a>
        <a href="/#community">Community</a>
        <a href="/#foot-newsletter">Contact</a>
      {% endif %}
    </nav>

    <!-- Right Actions -->
    <div class="nav-actions">
      <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="cta-pill"><i class="ph-duotone ph-shopping-bag-open"></i> {{ section.settings.cta_text | default: 'Shop now' }}</a>
      <a href="{{ routes.cart_url }}" class="nav-cart-btn" aria-label="Cart">
        <i class="ph-duotone ph-shopping-cart-simple" style="font-size: 22px;"></i>
        <span class="nav-cart-count" id="cartCount">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div class="mobile-menu-overlay">
  <div class="mobile-menu-panel">
    <div class="mobile-menu-header">
      <a class="brand" href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" style="height: 34px;" />
        {% else %}
          <img src="{{ 'splyn-logo-white.svg' | asset_url }}" alt="{{ shop.name }}" style="height: 34px;" />
        {% endif %}
      </a>
      <button class="mobile-menu-close" onclick="document.querySelector('.mobile-menu-overlay').classList.remove('is-open'); document.body.style.overflow='';" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <nav class="mobile-menu-links">
      {% if section.settings.menu != blank %}
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}" onclick="document.querySelector('.mobile-menu-overlay').classList.remove('is-open'); document.body.style.overflow='';">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="/" onclick="document.querySelector('.mobile-menu-overlay').classList.remove('is-open'); document.body.style.overflow='';">Home</a>
        <a href="/collections/all" onclick="document.querySelector('.mobile-menu-overlay').classList.remove('is-open'); document.body.style.overflow='';">Shop</a>
        <a href="/#story" onclick="document.querySelector('.mobile-menu-overlay').classList.remove('is-open'); document.body.style.overflow='';">About</a>
        <a href="/#community" onclick="document.querySelector('.mobile-menu-overlay').classList.remove('is-open'); document.body.style.overflow='';">Community</a>
        <a href="/#foot-newsletter" onclick="document.querySelector('.mobile-menu-overlay').classList.remove('is-open'); document.body.style.overflow='';">Contact</a>
      {% endif %}
    </nav>
    <div class="mobile-menu-footer">
      <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="btn btn-primary btn-full"><i class="ph-duotone ph-shopping-bag-open"></i> {{ section.settings.cta_text | default: 'Shop now' }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Desktop Logo Height",
      "default": 36
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ]
}
{% endschema %}
