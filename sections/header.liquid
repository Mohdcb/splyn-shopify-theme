
<!-- NAV -->
<header class="nav">
  <div class="nav-inner">
    <!-- Mobile Menu Toggle -->
    <button class="mobile-menu-toggle" aria-label="Menu" onclick="document.querySelector('.mobile-menu-overlay').classList.add('is-open'); document.body.style.overflow='hidden';">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <a class="brand" href="{{ routes.root_url }}">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" style="height: 56px;" />
      {% else %}
        <img src="{{ 'transparent_logo.png' | asset_url }}" alt="{{ shop.name }}" style="height: 56px;" />
      {% endif %}
    </a>

    <!-- Desktop Nav -->
    <nav class="links">
      {% if section.settings.menu != blank %}
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="/">Home</a>
        <a href="/collections/all">Shop</a>
        <a href="/#story">About</a>
        <a href="/#community">Community</a>
        <a href="/#foot-newsletter">Contact</a>
      {% endif %}
    </nav>

    <!-- Right Actions -->
    <div class="nav-actions">
      <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="cta-pill">{{ section.settings.cta_text | default: 'Shop now →' }}</a>
      <button class="nav-cart-btn" onclick="openCartDrawer()" aria-label="Cart">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <span class="nav-cart-count" id="cartCount">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div class="mobile-menu-overlay">
  <div class="mobile-menu-panel">
    <div class="mobile-menu-header">
      <a class="brand" href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" style="height: 40px;" />
        {% else %}
          <img src="{{ 'transparent_logo.png' | asset_url }}" alt="{{ shop.name }}" style="height: 40px;" />
        {% endif %}
      </a>
      <button class="mobile-menu-close" onclick="document.querySelector('.mobile-menu-overlay').classList.remove('is-open'); document.body.style.overflow='';" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <nav class="mobile-menu-links">
      {% if section.settings.menu != blank %}
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="/">Home</a>
        <a href="/collections/all">Shop</a>
        <a href="/#story">About</a>
        <a href="/#community">Community</a>
        <a href="/#foot-newsletter">Contact</a>
      {% endif %}
    </nav>
    <div class="mobile-menu-footer">
      <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="btn btn-primary btn-large" style="width:100%; text-align:center;">{{ section.settings.cta_text | default: 'Shop now →' }}</a>
    </div>
  </div>
</div>

<style>
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .nav-cart-btn {
    position: relative;
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    transition: opacity 0.2s;
  }

  .nav-cart-btn:hover { opacity: 0.8; }

  .nav-cart-count {
    position: absolute;
    top: -4px;
    right: -6px;
    background: var(--yellow);
    color: var(--purple-900);
    font-size: 10px;
    font-weight: 800;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Poppins', sans-serif;
  }

  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 4px;
  }

  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    visibility: hidden;
    opacity: 0;
    transition: visibility 0.3s, opacity 0.3s;
  }

  .mobile-menu-overlay.is-open {
    visibility: visible;
    opacity: 1;
  }

  .mobile-menu-overlay::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(4px);
  }

  .mobile-menu-panel {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 320px;
    max-width: 85vw;
    background: var(--purple-900);
    color: #fff;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.2, 0.9, 0.3, 1);
    z-index: 1;
  }

  .mobile-menu-overlay.is-open .mobile-menu-panel {
    transform: translateX(0);
  }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .mobile-menu-header .brand img {
    filter: brightness(0) invert(1);
  }

  .mobile-menu-close {
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 4px;
  }

  .mobile-menu-links {
    flex: 1;
    overflow-y: auto;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-menu-links a {
    display: block;
    padding: 14px 16px;
    font-size: 16px;
    font-weight: 600;
    color: #fff;
    border-radius: 12px;
    transition: background 0.2s;
  }

  .mobile-menu-links a:hover {
    background: rgba(255,255,255,0.08);
  }

  .mobile-menu-footer {
    padding: 20px;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  @media(max-width: 780px) {
    .mobile-menu-toggle {
      display: flex;
    }

    .links {
      display: none;
    }

    .cta-pill {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Shop now →"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ]
}
{% endschema %}
