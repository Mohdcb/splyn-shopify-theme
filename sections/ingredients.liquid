<!-- INGREDIENTS — Designed for the Human Body -->
<section id="ingredients" class="ingredients">
  <!-- Background image layers for section hover transition -->
  <div class="ingredients-bg-container">
    {% for block in section.blocks %}
      <div class="ingredients-bg-layer{% if forloop.first %} active{% endif %}" data-image="{{ forloop.index }}">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.title }}" />
        {% else %}
          <img src="{{ 'ing' | append: forloop.index | append: '.png' | asset_url }}" alt="{{ block.settings.title }}" />
        {% endif %}
      </div>
    {% endfor %}
    <!-- Opacity dark overlay layer for visibility & text contrast -->
    <div class="ingredients-overlay"></div>
  </div>

  <div class="container ingredients-content-wrapper">
    <div class="section-head reveal">
      <span class="chip chip-yellow">{{ section.settings.chip_text }}</span>
      <h2>{{ section.settings.heading }} <em>{{ section.settings.heading_italic }}</em></h2>
    </div>

    <div class="ingredients-showcase reveal">
      <div class="ingredients-list">
        {% for block in section.blocks %}
          <div class="ingredient-item{% if forloop.first %} active{% endif %}" data-image="{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="ingredient-content">
              <h3 class="ingredient-title"><span>{{ block.settings.title }}</span></h3>
              <p class="ingredient-tagline">{{ block.settings.tagline }}</p>
              {% if block.settings.description != blank %}
                <p class="ingredient-description">{{ block.settings.description }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients Showcase",
  "settings": [
    {
      "type": "text",
      "id": "chip_text",
      "label": "Chip Text",
      "default": "Inside Every Can"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for the"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (Italic)",
      "default": "Human Body."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "HYDRATE"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "default": "Electrolytes that restore"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Recharges vital minerals lost during intense workouts, keeping your muscles firing and hydration balanced all day long."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ingredient Background Image"
        },
        {
          "type": "text",
          "id": "caption_title",
          "label": "Image Caption Title",
          "default": "Electrolytes"
        },
        {
          "type": "text",
          "id": "caption_text",
          "label": "Image Caption Text",
          "default": "Restore what sweat takes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients Showcase",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "title": "HYDRATION",
            "tagline": "Not Water. Electrolytes.",
            "description": "Recharges vital minerals lost during intense workouts, keeping your muscles firing and hydration balanced all day long.",
            "caption_title": "Electrolytes",
            "caption_text": "Restore what sweat takes"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "FOCUS",
            "tagline": "Powered by L-Theanine",
            "description": "Promotes sustained alpha brain waves to enhance mental clarity, flow state, and concentration without any nervous jitters.",
            "caption_title": "L‑Theanine",
            "caption_text": "Calm focus for the long game"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "ENERGY",
            "tagline": "Caffeine without the crash",
            "description": "Delivers clean, balanced energy to power your day and elevate physical endurance with smooth, predictable momentum.",
            "caption_title": "Caffeine",
            "caption_text": "Pure performance, zero crash"
          }
        }
      ]
    }
  ]
}
{% endschema %}
