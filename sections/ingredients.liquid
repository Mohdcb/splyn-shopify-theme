<!-- INGREDIENTS — Designed for the Human Body -->
<section id="ingredients" class="ingredients">
  <div class="container">
    <div class="ingredients-head reveal text-center">
      <span class="chip chip-yellow">{{ section.settings.chip_text | default: 'Inside Every Can' }}</span>
      <h2>{{ section.settings.heading | default: 'Designed for the' }} <em>{{ section.settings.heading_italic | default: 'Human Body.' }}</em></h2>
      <p class="ingredients-subtext">{{ section.settings.subtext | default: 'Three core pillars formulated for peak physical recovery, mental flow state, and clean energy.' }}</p>
    </div>

    <div class="ingredients-grid reveal">
      {% for block in section.blocks %}
        <div class="ing-card ing-card-{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="ing-card-media">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}" />
            {% else %}
              <img src="{{ 'ing' | append: forloop.index | append: '.png' | asset_url }}" alt="{{ block.settings.title }}" />
            {% endif %}
            <div class="ing-card-badge">
              {% if forloop.index == 1 %}
                <i class="ph-duotone ph-drop"></i> <span>3 Key Electrolytes</span>
              {% elsif forloop.index == 2 %}
                <i class="ph-duotone ph-brain"></i> <span>75mg L-Theanine</span>
              {% else %}
                <i class="ph-duotone ph-lightning"></i> <span>75mg Caffeine</span>
              {% endif %}
            </div>
          </div>

          <div class="ing-card-content">
            <h3>{{ block.settings.title }}</h3>
            <span class="ing-tagline">{{ block.settings.tagline }}</span>
            <p>{{ block.settings.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients Showcase",
  "settings": [
    {
      "type": "text",
      "id": "chip_text",
      "label": "Chip Text",
      "default": "Inside Every Can"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Main",
      "default": "Designed for the"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading Accent (Italic)",
      "default": "Human Body."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext Paragraph",
      "default": "Three core pillars formulated for peak physical recovery, mental flow state, and clean energy."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "HYDRATION"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "default": "Not Water. Electrolytes."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Recharges vital minerals lost during intense workouts, keeping your muscles firing and hydration balanced all day long."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image Visual"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients Showcase",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "title": "HYDRATION",
            "tagline": "Not Water. Electrolytes.",
            "description": "Recharges vital minerals lost during intense workouts, keeping your muscles firing and hydration balanced all day long."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "FOCUS",
            "tagline": "Powered by L-Theanine",
            "description": "Promotes sustained alpha brain waves to enhance mental clarity, flow state, and concentration without any nervous jitters."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "ENERGY",
            "tagline": "Caffeine without the crash",
            "description": "Delivers clean, balanced energy to power your day and elevate physical endurance with smooth, predictable momentum."
          }
        }
      ]
    }
  ]
}
{% endschema %}
