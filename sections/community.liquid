<!-- COMMUNITY -->
<section id="community" class="community">
  <div class="container">
    <div class="community-inner">

      <!-- Left: Image Slider -->
      <div class="community-slider">
        <div class="slider-track">
          {% for block in section.blocks %}
            {% if block.type == 'slide' %}
              <div class="slide{% if forloop.first %} active{% endif %}" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.alt_text | default: 'SPLYN Community' }}" />
                {% else %}
                  <img src="{{ 'hero-bg.png' | asset_url }}" alt="SPLYN Community" />
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <!-- Navigation dots -->
        <div class="slider-dots">
          {% assign slide_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'slide' %}
              <button class="slider-dot{% if slide_index == 0 %} active{% endif %}" data-index="{{ slide_index }}"></button>
              {% assign slide_index = slide_index | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>

        <!-- Arrows -->
        <button class="slider-arrow prev" aria-label="Previous"><i class="ph-duotone ph-caret-left" style="font-size: 20px;"></i></button>
        <button class="slider-arrow next" aria-label="Next"><i class="ph-duotone ph-caret-right" style="font-size: 20px;"></i></button>
      </div>

      <!-- Right: Community CTA -->
      <div class="community-copy reveal">
        <span class="chip chip-yellow">{{ section.settings.chip_text }}</span>
        <h2>{{ section.settings.heading }} <em>{{ section.settings.heading_italic }}</em></h2>
        <p>{{ section.settings.description }}</p>
        <ul class="community-perks">
          {% for block in section.blocks %}
            {% if block.type == 'perk' %}
              <li {{ block.shopify_attributes }}>
                {% if forloop.index == 1 %}<i class="ph-duotone ph-lightning"></i>{% elsif forloop.index == 2 %}<i class="ph-duotone ph-users-three"></i>{% elsif forloop.index == 3 %}<i class="ph-duotone ph-gift"></i>{% elsif forloop.index == 4 %}<i class="ph-duotone ph-chats-circle"></i>{% else %}<i class="ph-duotone ph-calendar-check"></i>{% endif %}
                {{ block.settings.text }}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
        <a href="{% if section.settings.cta_link != blank %}{{ section.settings.cta_link }}{% else %}https://chat.whatsapp.com/{% endif %}" class="btn btn-whatsapp btn-large" target="_blank" rel="noopener noreferrer">
          <i class="ph-duotone ph-whatsapp-logo" style="font-size: 24px; margin-right: 8px;"></i>
          <span>{{ section.settings.cta_text | default: 'Join WhatsApp Community' }}</span>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Community",
  "settings": [
    {
      "type": "text",
      "id": "chip_text",
      "label": "Chip Text",
      "default": "Join the Movement"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Be part of the"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (Italic)",
      "default": "SPLYN family."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Thousands of athletes, creators, and everyday legends are already in the loop. Get early drops, exclusive recipes, community challenges, and direct access to the SPLYN team — all in one place."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Join Community"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slider Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "SPLYN Community"
        }
      ]
    },
    {
      "type": "perk",
      "name": "Community Perk",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Lucide Icon Name",
          "default": "zap",
          "info": "Use Lucide icon names: zap, users, gift, message-circle, etc."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Perk Text",
          "default": "Early access to new flavors & drops"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community",
      "blocks": [
        { "type": "slide", "settings": { "alt_text": "SPLYN Community" } },
        { "type": "slide", "settings": { "alt_text": "SPLYN Lifestyle" } },
        { "type": "slide", "settings": { "alt_text": "SPLYN Energy" } },
        { "type": "slide", "settings": { "alt_text": "SPLYN Performance" } },
        { "type": "slide", "settings": { "alt_text": "SPLYN Community Vibes" } },
        { "type": "perk", "settings": { "icon": "zap", "text": "Early access to new flavors & drops" } },
        { "type": "perk", "settings": { "icon": "users", "text": "Connect with the community" } },
        { "type": "perk", "settings": { "icon": "gift", "text": "Exclusive member-only offers" } },
        { "type": "perk", "settings": { "icon": "message-circle", "text": "Direct line to the SPLYN team" } }
      ]
    }
  ]
}
{% endschema %}
