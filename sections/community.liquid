<!-- COMMUNITY -->
<section id="community" class="community">
  <div class="container">
    <div class="community-inner">

      <!-- Left: Single Factory Image (No Slider) -->
      <div class="community-media reveal">
        <img src="{{ 'factory.jpeg' | asset_url }}" alt="SPLYN Factory & Community" class="community-image" />
      </div>

      <!-- Right: Community CTA -->
      <div class="community-copy reveal">
        <span class="chip chip-yellow">{{ section.settings.chip_text | default: 'Join the Movement' }}</span>
        <h2>{{ section.settings.heading | default: 'Be part of the' }} <em>{{ section.settings.heading_italic | default: 'SPLYN family.' }}</em></h2>
        <p>{{ section.settings.description | default: 'Thousands of athletes, creators, and everyday legends are already in the loop. Get early drops, exclusive recipes, community challenges, and direct access to the SPLYN team — all in one place.' }}</p>
        <ul class="community-perks">
          {% for block in section.blocks %}
            {% if block.type == 'perk' %}
              <li {{ block.shopify_attributes }}>
                {% if forloop.index == 1 %}<i class="ph-duotone ph-lightning"></i>{% elsif forloop.index == 2 %}<i class="ph-duotone ph-users-three"></i>{% elsif forloop.index == 3 %}<i class="ph-duotone ph-gift"></i>{% elsif forloop.index == 4 %}<i class="ph-duotone ph-chats-circle"></i>{% else %}<i class="ph-duotone ph-calendar-check"></i>{% endif %}
                {{ block.settings.text }}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
        <a href="{% if section.settings.cta_link != blank %}{{ section.settings.cta_link }}{% else %}https://chat.whatsapp.com/{% endif %}" class="btn btn-whatsapp btn-large" target="_blank" rel="noopener noreferrer">
          <i class="ph-duotone ph-whatsapp-logo" style="font-size: 24px; margin-right: 8px;"></i>
          <span>{{ section.settings.cta_text | default: 'Join WhatsApp Community' }}</span>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Community",
  "settings": [
    {
      "type": "text",
      "id": "chip_text",
      "label": "Chip Text",
      "default": "Join the Movement"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Be part of the"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (Italic)",
      "default": "SPLYN family."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Thousands of athletes, creators, and everyday legends are already in the loop. Get early drops, exclusive recipes, community challenges, and direct access to the SPLYN team — all in one place."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Join WhatsApp Community"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Community Perk",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Lucide Icon Name",
          "default": "zap"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Perk Text",
          "default": "Early access to new flavors & drops"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community",
      "blocks": [
        { "type": "perk", "settings": { "icon": "zap", "text": "Early access to new flavors & drops" } },
        { "type": "perk", "settings": { "icon": "users", "text": "Connect with the community" } },
        { "type": "perk", "settings": { "icon": "gift", "text": "Exclusive member-only offers" } },
        { "type": "perk", "settings": { "icon": "message-circle", "text": "Direct line to the SPLYN team" } }
      ]
    }
  ]
}
{% endschema %}
