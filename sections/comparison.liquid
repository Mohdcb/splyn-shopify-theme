<!-- COMPARISON SECTION -->
<section id="comparison" class="comparison">
  <div class="container">
    <div class="section-head reveal text-center">
      <span class="chip chip-yellow">{{ section.settings.chip_text | default: 'The SPLYN Advantage' }}</span>
      <h2>{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}Why{% endif %} <em>{% if section.settings.heading_italic != blank %}{{ section.settings.heading_italic }}{% else %}SPLYN{% endif %}</em><br>{% if section.settings.heading_end != blank %}{{ section.settings.heading_end }}{% else %}Beats Standard Drinks{% endif %}</h2>
      <p>{{ section.settings.subtext | default: 'See how SPLYN stacks up against energy drinks and electrolyte drinks.' }}</p>
    </div>

    <div class="comparison-wrapper reveal">
      <div class="comparison-table">
        <!-- Header Row -->
        <div class="comp-row comp-header">
          <div class="comp-col col-category">CATEGORY</div>
          <div class="comp-col col-other">ENERGY DRINKS</div>
          <div class="comp-col col-other">ELECTROLYTE DRINKS</div>
          <div class="comp-col col-splyn">
            <img src="{{ 'splyn-logo-white.svg' | asset_url }}" alt="SPLYN" class="comp-splyn-logo" />
          </div>
        </div>

        <!-- Row 1: Hydration -->
        <div class="comp-row">
          <div class="comp-col col-category">
            <i class="ph-duotone ph-drop"></i>
            <span>Hydration</span>
          </div>
          <div class="comp-col col-other"><span class="comp-val comp-no">No</span></div>
          <div class="comp-col col-other"><span class="comp-val comp-yes">Yes</span></div>
          <div class="comp-col col-splyn"><span class="comp-val comp-splyn-yes"><i class="ph-duotone ph-check-circle"></i> Yes</span></div>
        </div>

        <!-- Row 2: Focus -->
        <div class="comp-row">
          <div class="comp-col col-category">
            <i class="ph-duotone ph-target"></i>
            <span>Focus</span>
          </div>
          <div class="comp-col col-other"><span class="comp-val comp-no">No</span></div>
          <div class="comp-col col-other"><span class="comp-val comp-no">No</span></div>
          <div class="comp-col col-splyn"><span class="comp-val comp-splyn-yes"><i class="ph-duotone ph-check-circle"></i> Yes</span></div>
        </div>

        <!-- Row 3: Energy -->
        <div class="comp-row">
          <div class="comp-col col-category">
            <i class="ph-duotone ph-lightning"></i>
            <span>Energy</span>
          </div>
          <div class="comp-col col-other"><span class="comp-val comp-yes">Yes</span></div>
          <div class="comp-col col-other"><span class="comp-val comp-no">No</span></div>
          <div class="comp-col col-splyn"><span class="comp-val comp-splyn-yes"><i class="ph-duotone ph-check-circle"></i> Yes</span></div>
        </div>

        <!-- Row 4: Refined Sugar -->
        <div class="comp-row">
          <div class="comp-col col-category">
            <i class="ph-duotone ph-cube"></i>
            <span>Refined Sugar</span>
          </div>
          <div class="comp-col col-other"><span class="comp-val comp-yes">Yes</span></div>
          <div class="comp-col col-other"><span class="comp-val comp-yes">Yes</span></div>
          <div class="comp-col col-splyn"><span class="comp-val comp-splyn-no"><i class="ph-duotone ph-x-circle"></i> No</span></div>
        </div>

        <!-- Row 5: Calories -->
        <div class="comp-row">
          <div class="comp-col col-category">
            <i class="ph-duotone ph-flame"></i>
            <span>Calories</span>
          </div>
          <div class="comp-col col-other"><span class="comp-val comp-yes">Yes</span></div>
          <div class="comp-col col-other"><span class="comp-val comp-yes">Yes</span></div>
          <div class="comp-col col-splyn"><span class="comp-val comp-splyn-no"><i class="ph-duotone ph-x-circle"></i> No</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "chip_text",
      "label": "Chip Text",
      "default": "The SPLYN Advantage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Prefix",
      "default": "Why"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading Accent (Italic)",
      "default": "SPLYN Beats"
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Heading End",
      "default": "Standard Drinks"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "See how SPLYN stacks up against energy drinks and electrolyte drinks."
    }
  ],
  "presets": [
    {
      "name": "Comparison Table"
    }
  ]
}
{% endschema %}
