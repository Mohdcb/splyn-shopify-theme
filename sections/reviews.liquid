<!-- VIDEO REVIEWS -->
<section id="reviews" class="reviews">
  <div class="container">
    <div class="section-head reveal text-center">
      <span class="chip chip-yellow">{{ section.settings.chip_text | default: 'Real Talk' }}</span>
      <h2>{{ section.settings.heading | default: 'The' }} <em>{{ section.settings.heading_italic | default: 'hype' }}</em></h2>
      <p>{{ section.settings.subtext | default: 'Watch creators, athletes, and everyday legends experience SPLYN for the first time.' }}</p>
    </div>

    <div class="reviews-grid">
      {% for block in section.blocks %}
        <div class="review-card reveal" {% if forloop.index > 1 %}data-delay="{{ forloop.index0 | times: 100 }}"{% endif %} {{ block.shopify_attributes }}>
          <div class="review-video">
            <div class="review-video-placeholder">
              <div class="video-play-pulse">
                <i class="ph-duotone ph-video-camera"></i>
              </div>
              <span class="review-coming-soon-badge">✨ COMING SOON</span>
              <p class="review-coming-soon-tag">Community Video Reviews Dropping Soon 🔥</p>
            </div>
          </div>
          <div class="review-content">
            <div class="reviewer-info">
              <div class="reviewer-avatar" {% if block.settings.avatar_gradient != blank %}style="background: {{ block.settings.avatar_gradient }};"{% endif %}>
                <span>{{ block.settings.reviewer_name | slice: 0 }}</span>
              </div>
              <div class="reviewer-meta">
                <h4>{{ block.settings.reviewer_name }}</h4>
                <span>{{ block.settings.reviewer_title }}</span>
              </div>
            </div>
            <div class="review-stars" style="display: flex; gap: 4px; color: #f59e0b; margin: 8px 0 4px 0;">
              <i class="ph-duotone ph-star" style="font-size: 16px;"></i>
              <i class="ph-duotone ph-star" style="font-size: 16px;"></i>
              <i class="ph-duotone ph-star" style="font-size: 16px;"></i>
              <i class="ph-duotone ph-star" style="font-size: 16px;"></i>
              <i class="ph-duotone ph-star" style="font-size: 16px;"></i>
            </div>
            <p class="review-quote">"{{ block.settings.quote }}"</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video Reviews",
  "settings": [
    {
      "type": "text",
      "id": "chip_text",
      "label": "Chip Text",
      "default": "Real Talk"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (Italic)",
      "default": "hype"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Watch creators, athletes, and everyday legends experience SPLYN for the first time."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name",
          "default": "Alex Fitness"
        },
        {
          "type": "text",
          "id": "reviewer_title",
          "label": "Reviewer Title",
          "default": "Pro Athlete • 2.4M followers"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Quote",
          "default": "Finally a drink that keeps up with my training. Zero crash, all performance."
        },
        {
          "type": "text",
          "id": "avatar_gradient",
          "label": "Avatar Gradient CSS (optional)",
          "info": "e.g. linear-gradient(135deg, #ff6b9d, #c44569)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Reviews",
      "blocks": [
        {
