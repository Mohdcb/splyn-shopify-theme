<!-- HERO -->
<section class="hero">
  <div class="hero-bg-img">
    {% if section.settings.background_image != blank %}
      <img src="{{ section.settings.background_image | image_url: width: 2000 }}" alt="{{ section.settings.heading | escape }}" />
    {% else %}
      <img src="{{ 'hero-bg.png' | asset_url }}" alt="SPLYN — Performance Hydration" />
    {% endif %}
    <div class="hero-overlay"></div>
  </div>
  <div class="hero-content">
    {% if section.settings.eyebrow != blank %}
      <span class="hero-eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h1>{{ section.settings.heading }}<br><em>{{ section.settings.heading_italic }}</em></h1>
    <p>{{ section.settings.subtext }}</p>
    <div class="hero-ctas">
      <a href="{{ section.settings.cta_primary_link }}" class="btn btn-primary"><i class="ph-duotone ph-shopping-bag-open"></i> {{ section.settings.cta_primary_text }}</a>
      <a href="{{ section.settings.cta_secondary_link }}" class="btn btn-ghost"><i class="ph-duotone ph-compass"></i> {{ section.settings.cta_secondary_text }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "New • Performance Hydration"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Better Water"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (Italic Line)",
      "default": "For Better"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Zero sugar. Zero crash. Clean energy and deep hydration — in every can."
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary CTA Text",
      "default": "Shop Now — ₹199"
    },
    {
      "type": "url",
      "id": "cta_primary_link",
      "label": "Primary CTA Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary CTA Text",
      "default": "Explore →"
    },
    {
      "type": "url",
      "id": "cta_secondary_link",
      "label": "Secondary CTA Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
