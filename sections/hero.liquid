<!-- HERO -->
<section class="hero">
  <div class="hero-container">
    <!-- Left Column: Visual & Floating Feature Badges -->
    <div class="hero-visual">
      <div class="hero-img-wrapper">
        {% if section.settings.hero_image != blank %}
          <img src="{{ section.settings.hero_image | image_url: width: 2000 }}" alt="{{ section.settings.heading | escape }}" class="hero-can-img" />
        {% elsif section.settings.background_image != blank %}
          <img src="{{ section.settings.background_image | image_url: width: 2000 }}" alt="{{ section.settings.heading | escape }}" class="hero-can-img" />
        {% else %}
          <img src="{{ 'hero-splyn.png' | asset_url }}" alt="SPLYN — Performance Hydration" class="hero-can-img" />
        {% endif %}
        
        <!-- Floating Feature Badges -->
        {% if section.settings.show_badge1 != false %}
          <div class="hero-badge badge-1">
            <i class="ph-duotone {{ section.settings.badge1_icon | default: 'ph-drop' }}"></i>
            <div>
              <strong>{{ section.settings.badge1_title | default: '100%' }}</strong>
              <span>{{ section.settings.badge1_sub | default: 'Electrolytes' }}</span>
            </div>
          </div>
        {% endif %}

        {% if section.settings.show_badge2 != false %}
          <div class="hero-badge badge-2">
            <i class="ph-duotone {{ section.settings.badge2_icon | default: 'ph-lightning' }}"></i>
            <div>
              <strong>{{ section.settings.badge2_title | default: 'Zero' }}</strong>
              <span>{{ section.settings.badge2_sub | default: 'Sugar & Calories' }}</span>
            </div>
          </div>
        {% endif %}

        {% if section.settings.show_badge3 != false %}
          <div class="hero-badge badge-3">
            <i class="ph-duotone {{ section.settings.badge3_icon | default: 'ph-target' }}"></i>
            <div>
              <strong>{{ section.settings.badge3_title | default: 'Focus' }}</strong>
              <span>{{ section.settings.badge3_sub | default: 'L-Theanine Lift' }}</span>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Right Column: Text & CTAs -->
    <div class="hero-content">
      {% if section.settings.eyebrow != blank %}
        <div class="hero-eyebrow-wrapper">
          <span class="hero-eyebrow">
            <i class="ph-duotone ph-sparkle"></i> {{ section.settings.eyebrow }}
          </span>
        </div>
      {% endif %}

      <h1 class="hero-heading">
        {{ section.settings.heading | default: 'The can that does' }}
        {% if section.settings.heading_italic != blank %}
          <span class="hero-heading-highlight">{{ section.settings.heading_italic }}</span>
        {% endif %}
      </h1>

      <!-- Benefit Tags -->
      <div class="hero-feature-tags">
        <span class="tag"><i class="ph-duotone ph-drop"></i> {{ section.settings.tag1_text | default: 'Hydration' }}</span>
        <span class="tag-divider">•</span>
        <span class="tag"><i class="ph-duotone ph-target"></i> {{ section.settings.tag2_text | default: 'Focus' }}</span>
        <span class="tag-divider">•</span>
        <span class="tag"><i class="ph-duotone ph-lightning"></i> {{ section.settings.tag3_text | default: 'Energy' }}</span>
      </div>

      <p class="hero-subtext">{{ section.settings.subtext | default: 'Zero Sugar. Zero Calorie. Clean energy and deep hydration — in every can.' }}</p>

      <div class="hero-ctas">
        <a href="{{ section.settings.cta_primary_link | default: '/collections/all' }}" class="btn btn-hero-primary">
          <i class="ph-duotone ph-shopping-bag-open"></i> {{ section.settings.cta_primary_text | default: 'Shop Now — ₹199' }}
        </a>
        <a href="{{ section.settings.cta_secondary_link | default: '/#story' }}" class="btn btn-hero-secondary">
          <i class="ph-duotone ph-compass"></i> {{ section.settings.cta_secondary_text | default: 'Explore →' }}
        </a>
      </div>
    </div>
  </div>
</section>

