<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if page_title contains 'SPLYN' %}{{ page_title }}{% else %}{{ page_title }} — SPLYN® | Performance Hydration, Focus & Clean Energy{% endif %}</title>
  <meta name="description" content="{{ page_description | default: 'SPLYN is a next-generation performance hydration drink formulated with zero sugar, real electrolytes, 75mg caffeine, and L-theanine.' }}">
  
  <!-- Site Favicon & Touch Icons -->
  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}" />
  {% else %}
    <link rel="icon" type="image/png" href="{{ 'transparent_logo.png' | asset_url }}" />
    <link rel="shortcut icon" type="image/png" href="{{ 'transparent_logo.png' | asset_url }}" />
    <link rel="apple-touch-icon" href="{{ 'transparent_logo.png' | asset_url }}" />
  {% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  {{ 'styles.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>

  {% section 'header' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}
  {% section 'cart-drawer' %}

  <script src="{{ 'script.js' | asset_url }}" defer></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      lucide.createIcons();
    });
    /* Re-init Lucide after cart drawer refresh */
    var _origRefresh = typeof refreshCartDrawer === 'function' ? refreshCartDrawer : null;
  </script>
</body>
</html>
